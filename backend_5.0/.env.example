# ================================
# FloatChat Backend — .env.example
# ================================
# Copy this to .env and fill in real values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (same DB as ingestion service)
DATABASE_URL=postgresql://postgres:password@interchange.proxy.rlwy.net:20628/railway
DATABASE_URL_PUBLIC=postgresql://postgres:password@interchange.proxy.rlwy.net:20628/railway
DB_SSL=false
DB_MAX_CONNECTIONS=10

# JWT Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# LLM (Groq / OpenAI-compatible)
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-or-openai-api-key
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_BASE_URL=https://api.groq.com/openai/v1

# GTWY RAG Service
GTWY_AUTH_KEY=your-gtwy-auth-key
GTWY_RAG_API_URL=https://db.gtwy.ai
GTWY_RAG_QUERY_URL=https://api.gtwy.ai
GTWY_RAG_COLLECTION_ID=697df92c1f5b4176d9fcf7ce
GTWY_RAG_COLLECTION_MODE=high_accuracy

# Ingestion service (for proxy routes)
INGEST_SERVICE_URL=http://localhost:8100

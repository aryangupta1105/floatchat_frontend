# ========================
# Ingestion Service Config
# ========================

# Railway INTERNAL URL (works only inside Railway / Docker network)
DATABASE_URL=postgresql://user:password@postgres.railway.internal:5432/railway

# Railway PUBLIC PROXY URL (for LOCAL development â€” get it from Railway Dashboard > Connect > Public Networking)
DATABASE_URL_PUBLIC=postgresql://user:password@host.proxy.rlwy.net:port/railway

# Ingestion scheduler (auto-ingest every 6 hours)
INGEST_SCHEDULER_ENABLED=true
INGEST_SCHEDULER_INTERVAL_SECONDS=21600

# Flask server port
INGEST_PORT=8100
FLASK_DEBUG=false
